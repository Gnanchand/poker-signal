{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "durable_objects": {
    "bindings": [
      {
        "name": "POKER_ROOM",
        "class_name": "PokerRoom"
      }
    ]
  },
  "exports": {
    "PokerRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
